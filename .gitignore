# Project specific — DO NOT gitignore these:
# models/          <- keep model artifacts
# static/plots/    <- keep generated plots
# dataset/         <- keep dataset

# But DO ignore large generated files if needed:
# models/*.pkl     <- uncomment to exclude trained models from git
# static/plots/*.png <- uncomment to exclude plots from git
